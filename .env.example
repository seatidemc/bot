# ====== 运行环境 ======
# 配置分为 .env.dev（开发）和 .env.prod（生产）
# 通过 shell 环境变量 SEATIDE_ENV=dev|prod 选择，默认 dev
# 例：SEATIDE_ENV=prod python bot.py（Windows PowerShell: $env:SEATIDE_ENV="prod"）

# ====== DeepSeek 对话 ======
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_MAX_TURNS=10
AI_HISTORY_TTL=3600
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=800
AI_MAX_CONCURRENCY=4
# 群内不 @ 也参与聊天（true 开启，回复走被动消息）
AI_GROUP_CHAT_WITHOUT_AT=false
# 每分钟最多自动聊天回复次数（只统计未 @ 的群消息）
AI_GROUP_CHAT_PER_MINUTE=5
AI_TIMEOUT=60
AI_MAX_REPLY_CHARS=1200
# AI_SYSTEM_PROMPT=你是一个mc高手

# ====== 后端连接 ======
BACKEND_BASE_URL=http://127.0.0.1:45678

# ====== NoneBot 驱动 ======
# WebSocket 客户端模式（连接 QQ 开放平台）
DRIVER=~fastapi+~httpx+~websockets

# ====== QQ 官方机器人（QQ 开放平台） ======
# 群 openid：首次收到群消息会自动记录到 data/group_openid.txt
# 也可以手动填入固定使用；HTTP 接口依赖它
GROUP_OPENID=
# Bot 凭据（从 QQ 开放平台获取）
QQ_BOTS='
[
  {
    "id": "你的Bot AppID",
    "token": "你的Bot Token",
    "secret": "你的Bot Secret",
    "intent": {
      "c2c_group_at_messages": true
    }
  }
]
'

# ====== 对外 HTTP 接口 ======
# 只接受本机回环地址的请求，无需 token
HOST=127.0.0.1
PORT=8081
HTTP_API_MAX_CHARS=2000

# ====== 运行环境 ======
# 配置分为 .env.dev（开发）和 .env.prod（生产）
# 通过 shell 环境变量 SEATIDE_ENV=dev|prod 选择，默认 dev
# 例：SEATIDE_ENV=prod python bot.py（Windows PowerShell: $env:SEATIDE_ENV="prod"）

# ====== AI 工作流（System One router + chat / knowledge agent） ======
# 整个 AI 链路唯一开关：false 时所有非指令消息回复「暂未启动AI」
# true 时启动阶段会检查 router 与各 agent 的 Key/端点/提示词和 llms.txt URL，
# 配置不完整会直接启动失败
AI_ENABLED=true

# ====== AI 默认值（fallback） ======
# chat / knowledge 未单独配置时使用；固定走 openai-completions 格式
# （官方 openai SDK），router 不使用这些默认值
AI_DEFAULT_API_KEY=
# API 根地址，SDK 会自动拼接 /chat/completions；不要填完整端点
AI_DEFAULT_BASE_URL=https://api.deepseek.com
AI_DEFAULT_MODEL=deepseek-chat
AI_DEFAULT_TEMPERATURE=1.0
AI_DEFAULT_MAX_TOKENS=800
# 思考强度：none 关闭思考（不发送 reasoning_effort 字段，避免 JSON 模式偶发空白回复），low / high / max 开启思考
AI_DEFAULT_THINKING_EFFORT=low
AI_DEFAULT_TIMEOUT=60

# --- router：TypeSafe System One，选择 chat / knowledge ---
# 通过 typesafe-sdk 调用，不走 openai-completions，也不使用 AI_DEFAULT_*
# API Key 必填
AI_ROUTER_API_KEY=
# API 根地址；SDK 会自动请求 /v1/systemone
# 阿里云百炼决策模型用 https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode
AI_ROUTER_BASE_URL=https://api.typesafe.ai
AI_ROUTER_MODEL=jev-latest
# 单次请求超时；同时也是 SDK 重试的总预算（秒）
AI_ROUTER_TIMEOUT=20
# SDK 自动重试次数（不含首次请求），0 表示不重试
AI_ROUTER_MAX_RETRIES=2
# router 参考最近多少条用户消息（用于理解追问和指代；自动跳过 bot 回复和斜杠指令）
AI_ROUTER_HISTORY_TURNS=3
# knowledge 概率低于该值时按 chat 处理；0 表示不启用
AI_ROUTER_MIN_KNOWLEDGE_PROBABILITY=0.6
# 关键词快捷路由：命中词表中任意一行的正则时，直接判定 knowledge，不调用 System One
# 相对路径以项目根目录为准；每行一个正则（^前缀 / 后缀$ / .*包含.*），空行和 # 注释忽略
AI_ROUTER_KEYWORDS_FILE=data/keywords.txt

# --- chat：普通聊天 agent（API Key 留空则回退 AI_DEFAULT_API_KEY） ---
# BASE_URL 填 API 根地址，SDK 自动拼接 /chat/completions
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_CHAT_TEMPERATURE=1.0
AI_CHAT_THINKING_EFFORT=low
AI_CHAT_MAX_TOKENS=800
AI_CHAT_TIMEOUT=60
AI_CHAT_SYSTEM_PROMPT_FILE=prompts/chat_prompt.md

# --- knowledge：知识库问答 agent（API Key 留空则回退 AI_DEFAULT_API_KEY；llms.txt + fetch） ---
# BASE_URL 同样填 API 根地址（如 https://example.com/v1）
AI_KNOWLEDGE_API_KEY=
AI_KNOWLEDGE_BASE_URL=
AI_KNOWLEDGE_MODEL=
AI_KNOWLEDGE_TEMPERATURE=0.3
AI_KNOWLEDGE_THINKING_EFFORT=low
AI_KNOWLEDGE_MAX_TOKENS=800
AI_KNOWLEDGE_TIMEOUT=60
AI_KNOWLEDGE_SYSTEM_PROMPT_FILE=prompts/knowledge_prompt.md
# llms.txt 索引 URL，必须是 http/https；AI 开启时必填
AI_KNOWLEDGE_LLMS_TXT_URL=
AI_KNOWLEDGE_FETCH_TIMEOUT=15
# 索引/页面内存缓存秒数，0 表示不缓存
AI_KNOWLEDGE_CACHE_TTL=300
# fetch_seatide_wiki_doc 允许抓取的 URL 正则（必须完整匹配整个 URL，如 https://example\.com/.*）
# 留空表示只受 llms.txt 索引约束；重定向的每一跳都会校验。
# 若文档会 301 到其他域名（如 github.io → 自定义域名），必须同时放行目标域名，否则抓取会被拒绝
AI_KNOWLEDGE_FETCH_URL_REGEX=

# --- web_search：DeepSeek Search API（独立 Key，不回退 AI_DEFAULT_API_KEY） ---
# 配置 Key 后自动启用；显式设 false 可关闭
AI_WEB_SEARCH_API_KEY=
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_BASE_URL=https://api.deepseek.com
AI_WEB_SEARCH_TIMEOUT=20
AI_WEB_SEARCH_COUNT=5

# --- web_fetch：抓取任意公开网页正文（如 web_search 结果的内页） ---
# 只允许 http/https 公网地址，回环 / 内网 / 保留地址一律拒绝，重定向逐跳校验
AI_WEB_FETCH_ENABLED=true
AI_WEB_FETCH_TIMEOUT=20
# 单次返回给模型的最大字符数，超出截断并附提示
AI_WEB_FETCH_MAX_CHARS=20000

# --- weather：和风天气（chat agent 的 get_weather 工具） ---
# 新 API：每个账号一个 API Host（控制台分配），旧版 api.qweather.com 已弃用
AI_WEATHER_API_KEY=
# 可只填主机名（自动补 https://），不要带路径、查询参数或结尾斜杠
AI_WEATHER_API_HOST=
# 配置 API Key 后默认启用；启用时必须同时配置 API Host，否则启动校验失败
# 需要强制关闭时取消下一行注释
# AI_WEATHER_ENABLED=false
AI_WEATHER_TIMEOUT=15
# 每个自然月最多发往和风的请求数（含城市解析）；默认 50000 = 官方免费额度
# 0 表示不限制，超过免费额度后会按量计费
AI_WEATHER_MONTHLY_LIMIT=50000
# 成功查询结果的内存缓存秒数，0 表示不缓存
AI_WEATHER_CACHE_TTL=300

# --- 图片 / 视频 / 表情 ---
# QQ 附件 URL 带签名、会过期：无论下面开关如何，收到消息都会立即下载到 data/media/
# 交给模型时用 openai-completions 的 image_url / video_url content part，
# 要求 AI_CHAT_MODEL / AI_KNOWLEDGE_MODEL 支持图片和视频理解；
# 换成纯文本模型时请设为 false（图片仍会保存，只是不参与对话）
AI_MEDIA_ENABLED=true
# 历史消息附带媒体的条数（当前消息始终附带）；0 表示历史消息不带媒体
AI_MEDIA_CONTEXT_MESSAGES=3
# 单次模型请求最多附带多少个媒体（图片 + 视频合计），当前消息优先
AI_MEDIA_MAX_CONTEXT_ITEMS=6
# 单次请求所有媒体的 base64 字符总上限；百炼 DashScope 域名请求体上限 16MiB，
# 默认 12MiB 留出提示词余量；其他 OpenAI 兼容端点整体上限 64MB
AI_MEDIA_MAX_CONTEXT_BYTES=12582912
# 单个附件下载超时（秒）与体积上限（字节，默认 50 MiB）
AI_MEDIA_DOWNLOAD_TIMEOUT=30
AI_MEDIA_MAX_DOWNLOAD_BYTES=52428800
# 图片上限按编码前文件字节算（Qwen3.8 Base64 Data URI 上限 20MB）
AI_MEDIA_MAX_IMAGE_BYTES=10485760
# 视频上限按 base64 编码后的字符串算（百炼要求小于 10MB，故默认 10,000,000）
AI_MEDIA_MAX_VIDEO_BASE64_BYTES=10000000
# GIF 用 ffmpeg 转成百炼支持的格式：单帧转 PNG，动图转 MP4（不足 2 秒循环补齐）；
# 设为 false 时不转码，GIF 只保存不发给模型（百炼图片格式表里没有 GIF）
AI_MEDIA_GIF_TO_VIDEO=true
AI_MEDIA_FFMPEG_PATH=ffmpeg
AI_MEDIA_FFMPEG_TIMEOUT=60

# --- 会话 / agent loop ---
# 群聊上下文预置的最近聊天记录条数（永久记录在 data/chat_log.db）
AI_CHAT_LOG_RECENT=20
# 群内不 @ 也参与聊天（true 开启，回复走被动消息）
AI_GROUP_CHAT_WITHOUT_AT=false
# 每分钟最多自动聊天回复次数（只统计未 @ 的群消息）
AI_GROUP_CHAT_PER_MINUTE=5

# ====== 后端连接 ======
BACKEND_BASE_URL=http://127.0.0.1:45678/bot-v1

# ====== NoneBot 驱动 ======
# WebSocket 客户端模式（连接 QQ 开放平台）
DRIVER=~fastapi+~httpx+~websockets

# ====== QQ 官方机器人（QQ 开放平台） ======
# 默认目标群 openid：留空时自动记录收到的群到 data/group_openids.json（支持多个）
# 填入后作为 HTTP 接口的默认目标群
GROUP_OPENID=
# Bot 凭据（从 QQ 开放平台获取）
QQ_BOTS='
[
  {
    "id": "你的Bot AppID",
    "token": "你的Bot Token",
    "secret": "你的Bot Secret",
    "intent": {
      "c2c_group_at_messages": true
    }
  }
]
'

# ====== 对外 HTTP 接口 ======
# 只接受本机回环地址的请求，无需 token
HOST=127.0.0.1
PORT=8081
HTTP_API_MAX_CHARS=2000

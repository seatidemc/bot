# ====== 后端连接 ======
BACKEND_URL=http://127.0.0.1:45678
# 与后端 configs/main.toml 中 bot_key 保持一致
BOT_KEY=change-me
# Bot 自身的后端账号（需预先用 create_user 创建，operator 权限）
BOT_USERNAME=bot
BOT_PASSWORD=change-me

# ====== NoneBot 驱动 ======
# WebSocket 客户端模式（连接 QQ 开放平台）
DRIVER=~httpx+~websockets

# ====== QQ 官方机器人（QQ 开放平台） ======
# 群 openid：首次启动后在群里 @bot 发任意消息，bot 会打印到日志
# 填入后重启，SSE 状态推送才能正常工作
GROUP_OPENID=
# Bot 凭据（从 QQ 开放平台获取）
QQ_BOTS='
[
  {
    "id": "你的Bot AppID",
    "token": "你的Bot Token",
    "secret": "你的Bot Secret",
    "intent": {
      "c2c_group_at_messages": true
    }
  }
]
'
